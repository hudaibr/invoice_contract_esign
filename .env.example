# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/db?sslmode=require

# NextAuth
AUTH_SECRET=run-npx-auth-secret-to-generate

# DocuSeal
DOCUSEAL_URL=https://your-docuseal-instance.com
DOCUSEAL_API_KEY=your_api_key_here

# CRM (Google Sheets webhook — server-side, avoid CORS)
CRM_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
