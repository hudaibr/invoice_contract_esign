# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/db?sslmode=require

# NextAuth
AUTH_SECRET=run-npx-auth-secret-to-generate

# E-sign (company signature)
COMPANY_SIGNATORY_NAME=Authorized Representative
COMPANY_SIGNATORY_TITLE=Managing Member
COMPANY_SIGNATURE_URL=https://your-cdn.com/company-signature.png

# Supabase Storage (esign files)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Brevo (transactional emails)
BREVO_API_KEY=your_brevo_api_key
SIGNING_URL_BASE=http://localhost:3000

# CRM (Google Sheets webhooks — server-side, avoids CORS)
CRM_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
CRM_BACKUP_WEBHOOK_URL=https://script.google.com/macros/s/your-backup-script-id/exec

# PayPal Invoicing API
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MERCHANT_NAME=Jiggers in Joggers
PAYPAL_MERCHANT_EMAIL=hello@jiggersinjoggers.com
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_TEMPLATE_ID=optional_paypal_template_id
